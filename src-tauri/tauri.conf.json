{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CornerFlag",
  "version": "1.1.2",
  "identifier": "io.github.sbychul.cornerflag",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CornerFlag",
        "width": 320,
        "height": 146,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "menu",
        "title": "CornerFlag menu",
        "width": 196,
        "height": 153,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "CornerFlag Settings",
        "width": 560,
        "height": 734,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "about",
        "title": "About CornerFlag",
        "width": 360,
        "height": 296,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "macOS": { "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
